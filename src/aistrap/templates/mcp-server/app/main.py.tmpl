"""Standard I/O entry point for {{project_name}} MCP server."""

from __future__ import annotations

import json
import sys

from app.protocol import PARSE_ERROR, JsonRpcRequest, make_error
from app.server import McpServer


def main() -> int:
    """Run the MCP JSON-RPC stdio event loop."""
    server = McpServer()

    for line in sys.stdin:
        raw = line.strip()
        if not raw:
            continue

        try:
            payload = json.loads(raw)
            request = JsonRpcRequest.from_dict(payload)
        except Exception as exc:  # noqa: BLE001
            err_msg = make_error(None, PARSE_ERROR, f"Parse error: {exc}")
            sys.stdout.write(err_msg + "\n")
            sys.stdout.flush()
            continue

        response = server.handle_request(request)
        if response:
            sys.stdout.write(response + "\n")
            sys.stdout.flush()

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
