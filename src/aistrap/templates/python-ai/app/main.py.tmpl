"""Entry point for {{project_name}}.

Run it with::

    python -m app.main
"""

from __future__ import annotations

import logging
import re
from collections import Counter

from app.config import settings

logger = logging.getLogger(__name__)

SAMPLE_TEXT = """
Machine learning turns data into predictions. Good projects start with clean
data, a clear question, and a small experiment you can actually run.
"""

_WORD = re.compile(r"[a-zA-Z']+")


def tokenize(text: str) -> list[str]:
    """Split ``text`` into lowercase word tokens."""
    return [match.group().lower() for match in _WORD.finditer(text)]


def word_frequencies(text: str, limit: int = 5) -> list[tuple[str, int]]:
    """Return the ``limit`` most common words in ``text``.

    Args:
        text: The text to analyse.
        limit: How many results to return.

    Returns:
        A list of ``(word, count)`` pairs, most frequent first.
    """
    if limit < 0:
        raise ValueError("limit must not be negative")
    return Counter(tokenize(text)).most_common(limit)


def main() -> None:
    """Run a tiny demo so the project does something useful out of the box."""
    logging.basicConfig(level=settings.log_level, format="%(levelname)s %(message)s")
    logger.info("Starting %s", settings.app_name)

    print(f"{settings.app_name}: top words in the sample text")
    for word, count in word_frequencies(SAMPLE_TEXT):
        print(f"  {word:<12} {count}")


if __name__ == "__main__":
    main()
