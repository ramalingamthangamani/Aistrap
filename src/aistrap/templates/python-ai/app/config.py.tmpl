"""Application settings, loaded from environment variables.

Values come from the process environment. If ``python-dotenv`` is installed
(it is listed in requirements.txt) a local ``.env`` file is loaded as well, so
you can keep your settings in one place while developing.
"""

from __future__ import annotations

import os
from dataclasses import dataclass

try:
    from dotenv import load_dotenv
except ImportError:  # python-dotenv is optional at runtime

    def load_dotenv(*_args: object, **_kwargs: object) -> bool:
        return False


load_dotenv()


@dataclass(frozen=True)
class Settings:
    """Settings for {{project_name}}."""

    app_name: str = os.getenv("APP_NAME", "{{project_name}}")
    log_level: str = os.getenv("LOG_LEVEL", "INFO")


settings = Settings()
