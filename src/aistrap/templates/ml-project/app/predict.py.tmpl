"""Make predictions with the trained {{project_name}} model.

Run it with::

    python -m app.predict 5.1 3.5 1.4 0.2
"""

from __future__ import annotations

import logging
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Sequence

import joblib

from app.config import settings

logger = logging.getLogger(__name__)

#: A well-known iris measurement, used when no features are given.
EXAMPLE_FEATURES = [5.1, 3.5, 1.4, 0.2]


class ModelNotTrainedError(FileNotFoundError):
    """Raised when the model file does not exist yet."""


@dataclass(frozen=True)
class Prediction:
    """A predicted class and how confident the model is."""

    label: str
    confidence: float


def load_model(model_path: Path | None = None) -> dict[str, Any]:
    """Load the saved model bundle.

    Raises:
        ModelNotTrainedError: if the model file is missing. Train first with
            ``python -m app.train``.
    """
    path = Path(model_path) if model_path is not None else settings.model_path
    if not path.is_file():
        raise ModelNotTrainedError(
            f"No model found at {path}. Train one first with: python -m app.train"
        )
    return joblib.load(path)


def predict(features: Sequence[float], model: dict[str, Any] | None = None) -> Prediction:
    """Predict the class of a single sample.

    Args:
        features: One row of feature values.
        model: A loaded model bundle. Loaded from disk when omitted.

    Raises:
        ValueError: if the number of features does not match the model.
    """
    bundle = model if model is not None else load_model()
    expected = len(bundle["feature_names"])
    if len(features) != expected:
        raise ValueError(
            f"Expected {expected} features ({', '.join(bundle['feature_names'])}), "
            f"got {len(features)}."
        )

    pipeline = bundle["pipeline"]
    index = int(pipeline.predict([list(features)])[0])
    probabilities = pipeline.predict_proba([list(features)])[0]
    return Prediction(
        label=bundle["target_names"][index],
        confidence=float(probabilities[index]),
    )


def main(argv: list[str] | None = None) -> int:
    """Predict from feature values passed on the command line."""
    logging.basicConfig(level=settings.log_level, format="%(levelname)s %(message)s")
    arguments = list(sys.argv[1:] if argv is None else argv)

    if arguments:
        try:
            features = [float(value) for value in arguments]
        except ValueError:
            print("All feature values must be numbers.", file=sys.stderr)
            return 2
    else:
        features = EXAMPLE_FEATURES
        print(f"No features given, using the example sample {features}.")

    try:
        result = predict(features)
    except (ModelNotTrainedError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        return 1

    print(f"Prediction: {result.label} (confidence {result.confidence:.3f})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
